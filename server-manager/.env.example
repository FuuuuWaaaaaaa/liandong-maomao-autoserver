NODE_ENV=development
PORT=8080
HOST=0.0.0.0
# Production uses an independent MySQL service. memory is only for local tests.
SQL_TYPE=mysql
SQL_ADDRESS=mysql://manager:change-me@127.0.0.1:3306/minecraft_manager
# Backward-compatible aliases; SQL_TYPE/SQL_ADDRESS take precedence.
# STORAGE_MODE=mysql
# DATABASE_URL=mysql://manager:change-me@127.0.0.1:3306/minecraft_manager
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_API_TOKEN=replace-with-a-separate-admin-token
# Proxy tokens are bootstrap-only examples. Store hashes in proxy_instances in production.
PROXY_TOKENS=proxy-main=replace-with-proxy-token
PTERODACTYL_URL=https://panel.example.net
PTERODACTYL_API_TOKEN=replace-with-client-api-token
PTERODACTYL_TIMEOUT_MS=5000
HEARTBEAT_FRESHNESS_SECONDS=45
